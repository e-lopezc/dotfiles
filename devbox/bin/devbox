#!/usr/bin/env bash
# devbox — launch the portable DevOps/SRE tool container.
#
# The current directory becomes /workspace. The image carries the tools; this
# script injects credentials at launch and NEVER bakes them in:
#   - git over SSH via agent forwarding, only with --ssh (your private key
#     never enters the box; the agent SOCKET does)
#   - AWS via `aws-vault exec` on the host (temporary STS creds as env vars)
#   - kube config only when you ask for it (read-only)
#
# Usage:
#   devbox                      # shell in $PWD
#   devbox --ssh                # + forward the SSH agent (git push, etc.)
#   devbox --kube               # + mount ~/.kube (read-only)
#   devbox --aws PROFILE        # + inject temp AWS creds via aws-vault
#   devbox --force              # skip the $PWD safety guard
#   devbox --kube --aws prod    # combine
#   devbox -- CMD [args...]     # run a one-off command instead of a shell
#   devbox nvim .                (bare command also works)
#
# Env overrides: DEVBOX_IMAGE (default devbox:latest), DEVBOX_SSH_SOCK,
# DEVBOX_FORCE=1 (same as --force), DEVBOX_PIDS (default 512).

set -eo pipefail

IMAGE="${DEVBOX_IMAGE:-devbox:latest}"

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

SSH=0
KUBE=0
FORCE="${DEVBOX_FORCE:-0}"
AWS_PROFILE=""
CMD=()

while [ $# -gt 0 ]; do
  case "$1" in
    --ssh)       SSH=1; shift ;;
    --kube)      KUBE=1; shift ;;
    --force)     FORCE=1; shift ;;
    --aws)       AWS_PROFILE="${2:?--aws needs a profile name}"; shift 2 ;;
    --aws=*)     AWS_PROFILE="${1#*=}"; shift ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; CMD+=("$@"); break ;;
    *)           CMD+=("$1"); shift ;;
  esac
done

# --- $PWD safety guard --------------------------------------------------------
# Refuses to mount directories whose contents would hand secrets, or the
# launcher itself, to the container. -ef (device+inode) is used instead of
# string-prefix matching: macOS's case-insensitive APFS means
# `cd /Users/elias && pwd -P` can return `/users/elias`, which no string
# comparison against $HOME would catch.
is_at_or_under() {
  # is_at_or_under <ancestor> <path> -> true if <path> is <ancestor> or below it
  local anc="$1" p="$2"
  while :; do
    [ "$p" -ef "$anc" ] && return 0
    [ "$p" = "/" ] && return 1
    p="$(dirname "$p")"
  done
}

if [ "$FORCE" = 1 ]; then
  echo "devbox: WARNING — \$PWD guard bypassed (--force/DEVBOX_FORCE) for '$PWD'" >&2
elif is_at_or_under "$PWD" "$HOME"; then
  echo "devbox: refusing to mount '$PWD' — it is \$HOME or an ancestor of it." >&2
  echo "        Run devbox from inside a project directory, or pass --force." >&2
  exit 1
else
  sensitive=("$HOME/.ssh" "$HOME/.aws" "$HOME/.kube" "$HOME/.gnupg" \
             "$HOME/.docker" "$HOME/.config/gh" "$HOME/.local/bin" "$HOME/Library")
  for s in "${sensitive[@]}"; do
    [ -e "$s" ] || continue
    if is_at_or_under "$s" "$PWD"; then
      echo "devbox: refusing to mount '$PWD' — it is at/under '$s'." >&2
      echo "        Pass --force to override." >&2
      exit 1
    fi
  done

  if is_at_or_under "$HOME" "$PWD"; then
    rel="${PWD#"$HOME"/}"
    top="${rel%%/*}"
    case "$top" in
      .*)
        if [ ! -t 0 ] || [ ! -t 1 ]; then
          echo "devbox: refusing to mount '$PWD' (a dotdir under \$HOME) non-interactively." >&2
          echo "        Pass --force to override." >&2
          exit 1
        fi
        echo "devbox: '$PWD' is a dotdir under \$HOME; it will be mounted read-write." >&2
        printf "        Continue? [y/N] " >&2
        read -r reply
        case "$reply" in
          y|Y|yes|YES) ;;
          *) echo "devbox: aborted." >&2; exit 1 ;;
        esac
        ;;
    esac
  fi
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "devbox: docker not found on PATH" >&2
  exit 1
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "devbox: image '$IMAGE' not found — build it first:" >&2
  echo "        (cd <dotfiles>/devbox && make build)" >&2
  exit 1
fi

ARGS=(run --rm --hostname devbox -w /workspace
      --security-opt no-new-privileges --cap-drop ALL
      --pids-limit "${DEVBOX_PIDS:-512}")
# allocate a TTY only when attached to one, so `devbox -- cmd` works in scripts
if [ -t 0 ] && [ -t 1 ]; then ARGS+=(-it); else ARGS+=(-i); fi
ARGS+=(-e "TERM=${TERM:-xterm-256color}")
ARGS+=(-v "$PWD:/workspace")

# persisted, non-secret state
ARGS+=(-v devbox-hist:/home/dev/.local/state/devbox)
ARGS+=(-v devbox-uv-cache:/home/dev/.cache/uv)

# git identity (not a secret; enables signed-authored commits)
[ -f "$HOME/.gitconfig" ] && ARGS+=(-v "$HOME/.gitconfig:/home/dev/.gitconfig:ro")

# --- SSH agent forwarding (opt-in; key material never crosses, only the socket) --
if [ "$SSH" = 1 ]; then
  case "$(uname -s)" in
    Darwin) SSH_SOCK="${DEVBOX_SSH_SOCK:-/run/host-services/ssh-auth.sock}" ;;
    *)      SSH_SOCK="${DEVBOX_SSH_SOCK:-$SSH_AUTH_SOCK}" ;;
  esac
  if [ -n "$SSH_SOCK" ]; then
    ARGS+=(-v "$SSH_SOCK:/ssh-agent" -e "SSH_AUTH_SOCK=/ssh-agent")
  else
    echo "devbox: --ssh requested but no SSH agent socket found; git over SSH won't work this session" >&2
  fi
fi

# --- kube config (opt-in, read-only) -----------------------------------------
if [ "$KUBE" = 1 ]; then
  if [ -d "$HOME/.kube" ]; then
    ARGS+=(-v "$HOME/.kube:/home/dev/.kube:ro")
  else
    echo "devbox: ~/.kube not found; skipping --kube" >&2
  fi
fi

# --- AWS (temporary creds via aws-vault on the host) -------------------------
if [ -n "$AWS_PROFILE" ]; then
  if ! command -v aws-vault >/dev/null 2>&1; then
    echo "devbox: --aws needs aws-vault on the host PATH" >&2
    exit 1
  fi
  AWS_ENV=(-e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN \
           -e AWS_SECURITY_TOKEN -e AWS_REGION -e AWS_DEFAULT_REGION)
  exec aws-vault exec "$AWS_PROFILE" -- \
    docker "${ARGS[@]}" "${AWS_ENV[@]}" "$IMAGE" ${CMD[@]+"${CMD[@]}"}
fi

exec docker "${ARGS[@]}" "$IMAGE" ${CMD[@]+"${CMD[@]}"}
